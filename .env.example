# Скопируйте этот файл под именем .env и заполните.

# Адрес сайта: нужен только для встроенного Caddy (отдельный сервер, docker compose --profile caddy).
# На сервере с ботами https делает nginx, строку можно не трогать.
DOMAIN=sklad.example.ru

# Первый администратор. Создаётся при первом запуске, если пользователей ещё нет.
# Пароль не короче 8 символов. После входа его можно сменить во вкладке «Пользователи».
ADMIN_LOGIN=admin
ADMIN_PASSWORD=придумайте-длинный-пароль
ADMIN_NAME=Администратор

# Кто распознаёт документы: yandex (сервер в России) или anthropic (Claude, сервер за рубежом).
# Если ключ выбранного провайдера не указан, распознавание выключено, остальное работает (приход вручную).
AI_PROVIDER=yandex

# --- Яндекс (AI Studio): ключ API сервисного аккаунта с ролями ai.languageModels.user и ai.vision.user,
# и идентификатор каталога (folder ID). Ключ никому не отправляйте.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель разбора текста. Можно попробовать aliceai-llm или yandexgpt-5-pro/latest.
# YANDEX_MODEL=yandexgpt/latest
# Модель распознавания сканов: markdown (таблицы в виде Markdown), table или page.
# YANDEX_OCR_MODEL=markdown
# Записывать полные ответы ИИ в data/ai-log (последние 100), чтобы разбирать ошибки распознавания.
AI_LOG=1

# --- Anthropic (Claude): ключ с console.anthropic.com. Из России API недоступно.
ANTHROPIC_API_KEY=

# Необязательные настройки
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_QUICK=claude-haiku-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# SESSION_DAYS=30
# PORT=3000
# DATA_DIR=./data
